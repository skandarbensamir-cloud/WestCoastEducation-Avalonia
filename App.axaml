<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WestCoastEducationAvalonia.App"
             xmlns:local="using:WestCoastEducationAvalonia"
             RequestedThemeVariant="Dark">
             

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

       <Application.Resources>
        <!-- Neon-solnedgång som bakgrund inspirerad av ett TV-Spel-->
        <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1A0B2E" Offset="0" />
            <GradientStop Color="#5B1A7A" Offset="0.5" />
            <GradientStop Color="#C2185B" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SurfaceBrush" Color="#CC140A24" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />

        <!-- Neonfärger också inspirerat av ett TV-Spel -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2E88" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF8C42" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#00E5FF" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF" />
        <Color x:Key="SystemAccentColor">#00E5FF</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
       
        <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
        </Style>
         
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
        </Style>
            <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

    </Application.Styles>
</Application>