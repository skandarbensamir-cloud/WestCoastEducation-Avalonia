<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WestCoastEducationAvalonia.ViewModels"
        xmlns:models="using:WestCoastEducationAvalonia.Models"
        xmlns:views="using:WestCoastEducationAvalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestCoastEducationAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WestCoastEducationAvalonia">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
     
    <TabControl Margin="10">
        <TabItem Header="Courses">
            <views:CoursesView />
        </TabItem>
        <TabItem Header="Students">
            <views:StudentsView />
        </TabItem>
    </TabControl>
</Window>
