<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestCoastEducationAvalonia.ViewModels"
             xmlns:models="using:WestCoastEducationAvalonia.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastEducationAvalonia.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

    <DockPanel Margin="10">
        <Button DockPanel.Dock="Top"
                Content="Load courses"
                Command="{Binding LoadCoursesCommand}"
                Margin="0,0,0,10" />
    <StackPanel DockPanel.Dock="Right" Width="280" Spacing="6" Margin="10,0,0,0">
            <TextBlock Text="New course" FontWeight="Bold" />

            <TextBlock Text="Course number" />
            <TextBox Text="{Binding NewCourseNumber}" />

            <TextBlock Text="Title" />
            <TextBox Text="{Binding NewCourseTitle}" />

            <TextBlock Text="Length" />
            <NumericUpDown Value="{Binding NewLength}" Minimum="1" Increment="1" FormatString="0" />

            <TextBlock Text="Start date" />
            <CalendarDatePicker SelectedDate="{Binding NewStartDate}" />

            <TextBlock Text="End date" />
            <CalendarDatePicker SelectedDate="{Binding NewEndDate}" />

            <TextBlock Text="Type" />
            <ComboBox ItemsSource="{Binding CourseTypes}" SelectedItem="{Binding NewCourseType}" />

            <Button Content="Add course" Command="{Binding AddCourseCommand}" Margin="0,6,0,0" />
            <Button Content="Update selected course" Command="{Binding UpdateCourseCommand}"/>
            <Button Content="Delete selected course" Command="{Binding DeleteCourseCommand}" Margin="0,20,0,0" />
    </StackPanel>
        
    <ListBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Course">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding CourseNumber}" FontWeight="Bold" />
                        <TextBlock Text="{Binding CourseTitle}" />
                        <TextBlock Text="{Binding CourseType}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>


