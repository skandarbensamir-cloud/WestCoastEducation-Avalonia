<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestCoastEducationAvalonia.ViewModels"
             xmlns:models="using:WestCoastEducationAvalonia.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastEducationAvalonia.Views.TeachersView"
             x:DataType="vm:TeachersViewModel">

    <DockPanel Margin="10">
        <Button DockPanel.Dock="Top"
                Content="Load teachers"
                Command="{Binding LoadTeachersCommand}"
                Margin="0,0,0,10"/>

    <StackPanel DockPanel.Dock="Right" Width="280" Spacing="6" Margin="10,0,0,0">
            <TextBlock Text="New teacher" FontWeight="Bold"/>

            <TextBlock Text="First name"/>
            <TextBox Text="{Binding NewTeacherFirstName}"/>

            <TextBlock Text="Last name" />
            <TextBox Text="{Binding NewTeacherLastName}"/>

            <TextBlock Text="Personal identity number"/>
            <TextBox Text="{Binding NewTeacherPersonIdentityNumber}"/>

            <TextBlock Text="Phone number"/>
            <TextBox Text="{Binding NewTeacherPhoneNumber}"/>

            <TextBlock Text="Knowledge area" />
            <TextBox Text="{Binding NewKnowledgeArea}"/>

            <Button Content="Add teacher" Command="{Binding AddTeacherCommand}" Margin="0,6,0,0"/>
            <Button Content="Updated selected teacher" Command="{Binding UpdateTeacherCommand}"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Teachers}" SelectedItem="{Binding SelectedTeacher}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Teacher">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding FirstName}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LastName}"/>
                        <TextBlock Text="{Binding KnowledgeArea}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>